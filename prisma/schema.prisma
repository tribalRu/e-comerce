// КуклаМаркет — интернет-магазин кукол в стиле Target
// Prisma schema: категории, товары, корзина, заказы, настройки витрины (CMS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id           Int            @id @default(autoincrement())
  slug         String         @unique
  name         String
  description  String
  price        Int // цена в рублях
  oldPrice     Int? // старая цена (для акций)
  image        String // главное фото (денормализовано из images; показывается на карточке)
  rating       Float          @default(4.5)
  reviewsCount Int            @default(0)
  badge        String? // hit | new | sale | deal
  brand        String         @default("КуклаМаркет")
  ageMin       Int            @default(3)
  stock        Int            @default(25)
  featured     Boolean        @default(false)
  categoryId   Int
  category     Category       @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime       @default(now())

  @@index([categoryId])
  @@index([featured])
}

// Фотографии товара (галерея): порядок — sortOrder, главная — isMain
// (ровно одна; Product.image всегда синхронизируется с ней)
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // /images/products/<файл> или /images/uploads/<файл>
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  @@index([productId, sortOrder])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String // значение cookie km_cart
  productId Int
  quantity  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique // КМ-123456
  cartId       String
  customerName String
  phone        String
  email        String?
  address      String?
  delivery     String      @default("courier") // courier | pickup
  payment      String      @default("card") // card | cash
  comment      String?
  total        Int // ₽
  status       String      @default("new")
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId Int
  name      String // снапшот на момент заказа
  price     Int
  image     String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// Настройки витрины (singleton, id = 1): фичи-переключатели и баннер
// (постер + тексты). Постер: стандартный /images/hero-dolls.png или
// загруженный через админку /images/hero/<файл>.
model SiteSettings {
  id                 Int      @id @default(1)
  aiAssistantEnabled Boolean  @default(true)
  voiceSearchEnabled Boolean  @default(true)
  accountEnabled     Boolean  @default(true)
  cartEnabled        Boolean  @default(true)
  heroImage          String   @default("/images/hero-dolls.png")
  heroKicker         String   @default("Неделя кукол")
  heroTitle          String   @default("Мир кукол со скидками до 40%")
  heroSubtitle       String   @default("Модные наряды, уютные домики и фарфоровые коллекционные куклы — всё для игры и восхищения.")
  heroCtaText        String   @default("Смотреть каталог")
  updatedAt          DateTime @updatedAt
}
